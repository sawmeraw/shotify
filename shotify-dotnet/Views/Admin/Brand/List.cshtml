@using Shotify.Models.DTOs
@model List<BrandListItemDTO>
@{
    ViewData["Title"] = "Brands";
    ViewData["PageHeading"] = "Brands";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-muted mb-0">Manage your product brands and manufacturers.</p>
    <a href="/admin/brand/create" class="btn btn-dark px-4">+ Add New Brand</a>
</div>

<div class="brand-list-table">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var brand in Model)
                {
                    <tr class="@(brand.IsDeleted ? "table-row-deleted" : "")">
                        <td>
                            <span class="fw-semibold">@brand.Name</span>
                        </td>
                        <td>
                            @if (brand.IsDeleted)
                            {
                                <span class="badge bg-danger">Deleted</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="/admin/brand/@brand.Id" class="btn btn-sm btn-outline-dark me-1">Edit</a>
                            @if (!brand.IsDeleted)
                            {
                                <form method="post" action="/api/brand/@brand.Id/delete" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="/api/brand/@brand.Id/restore" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center py-5 text-muted">
                        No brands found. Click "Add New Brand" to get started.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
